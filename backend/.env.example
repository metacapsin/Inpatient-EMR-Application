# CI note: .github/workflows/ci.yml provides DATABASE_URL and dummy JWT secrets for the test job; no real
# credentials are ever read from this file in CI.
# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
# Either a full URL...
DATABASE_URL=postgres://emr_user:change-me@localhost:5432/emr
# ...used by the dev-only embedded server (npm run db:embedded) too:
PGDATA_DIR=./.pgdata
# TLS to Postgres: "require" (default in production) or "disable" (default outside it — local/CI
# Postgres isn't TLS-configured). Only set DATABASE_SSL_REJECT_UNAUTHORIZED=false if your provider's
# cert chain genuinely isn't in Node's trust store.
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Auth ---
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Platform (Super Admin) tokens use a separate secret so a leaked tenant token can never be
# replayed as a platform token. Optional: defaults to a value derived from JWT_SECRET if unset.
# Set this explicitly in production.
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_TTL=30m
# SMART App Launch / patient-portal tokens — separate from staff JWT_SECRET for the same reason.
# Optional outside production (derives from JWT_SECRET if unset); required when NODE_ENV=production.
SMART_JWT_SECRET=
# Dev-convenience tokens (invite links, password-reset tokens) returned in API responses or logged
# to the console, instead of only emailed. Off by default; on automatically under NODE_ENV=test.
# ALLOW_DEV_TOKENS=false
# AES-256-GCM key (64 hex chars = 32 bytes) for the few secret fields this app stores and later needs
# back in plaintext (currently just a notification recipient's webhook Authorization header). Optional
# outside production (derives from JWT_SECRET if unset); required when NODE_ENV=production. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Plaintext MLLP (mllp://) carries HL7 PHI over an unencrypted TCP socket. Off by default — use
# mllps:// (TLS) instead, or set this only when the connection is already on a private/VPN link.
# ALLOW_PLAINTEXT_MLLP=false

# --- Seed data (used only by npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too

# --- Seed platform admin (used only by npm run db:seed:platform; no self-service signup exists) ---
SEED_PLATFORM_ADMIN_EMAIL=superadmin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=change-me-too

# --- Outbound email (tenant-admin invites, etc.) ---
# Leave SMTP_HOST empty to log emails to the console instead of sending them (dev/test default).
# Works with any SMTP provider: Gmail (use an App Password), Mailtrap (sandbox, no real delivery),
# or the SMTP relay most transactional providers (Resend/SendGrid/Postmark/SES) expose.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Base URL used to build links inside outbound emails (invite / set-password links).
FRONTEND_URL=http://localhost:5173
# This server's own public base URL — used for absolute SMART discovery endpoints and the expected
# `aud` on /oauth/authorize. Required in production.
BACKEND_URL=http://localhost:4000

# --- Third-party (kept server-side) ---
# Public tenant self-signup (POST /auth/register). Off by default; tenants are provisioned by a platform admin.
# ALLOW_SELF_SERVICE_REGISTRATION=false

GEMINI_API_KEY=
# Model used by /api/ai/* (REST generateContent). Timeout in ms.
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=20000

# Stedi (payer directory search + real-time insurance eligibility 270/271).
# Leave STEDI_API_KEY empty to disable: payer search returns 503 and eligibility checks report 'skipped'.
STEDI_API_KEY=
STEDI_ENABLED=true
# STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# STEDI_PAYERS_BASE_URL=https://payers.us.stedi.com/2024-04-01
