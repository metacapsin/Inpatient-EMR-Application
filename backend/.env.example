# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
# Either a full URL...
DATABASE_URL=postgres://emr_user:change-me@localhost:5432/emr
# ...used by the dev-only embedded server (npm run db:embedded) too:
PGDATA_DIR=./.pgdata

# --- Auth ---
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Platform (Super Admin) tokens use a separate secret so a leaked tenant token can never be
# replayed as a platform token. Optional: defaults to a value derived from JWT_SECRET if unset.
# Set this explicitly in production.
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_TTL=30m

# --- Seed data (used only by npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too

# --- Seed platform admin (used only by npm run db:seed:platform; no self-service signup exists) ---
SEED_PLATFORM_ADMIN_EMAIL=superadmin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=change-me-too

# --- Outbound email (tenant-admin invites, etc.) ---
# Leave SMTP_HOST empty to log emails to the console instead of sending them (dev/test default).
# Works with any SMTP provider: Gmail (use an App Password), Mailtrap (sandbox, no real delivery),
# or the SMTP relay most transactional providers (Resend/SendGrid/Postmark/SES) expose.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Base URL used to build links inside outbound emails (invite / set-password links).
FRONTEND_URL=http://localhost:5173

# --- Third-party (kept server-side) ---
GEMINI_API_KEY=

# Stedi (payer directory search + real-time insurance eligibility 270/271).
# Leave STEDI_API_KEY empty to disable: payer search returns 503 and eligibility checks report 'skipped'.
STEDI_API_KEY=
STEDI_ENABLED=true
# STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# STEDI_PAYERS_BASE_URL=https://payers.us.stedi.com/2024-04-01
