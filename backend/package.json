{
  "name": "emr-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + PostgreSQL API for the Inpatient EMR frontend",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:embedded": "node scripts/embedded-db.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:platform": "node src/db/seedPlatform.js",
    "db:seed:icd10": "node src/db/seedIcd10.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "db:seed:cds": "node src/db/seedCds.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "inpatient-emr": "file:..",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/fhir": "^0.0.44",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
