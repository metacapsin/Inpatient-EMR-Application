{
    "name": "inpatient-emr",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "npm run dev:frontend",
        "dev:frontend": "npm --prefix frontend run dev",
        "dev:backend": "npm --prefix backend run dev",
        "dev:db": "npm --prefix backend run db:embedded",
        "dev:all": "concurrently -k -n db,api,web -c blue,green,magenta \"npm:dev:db\" \"npm:dev:backend\" \"npm:dev:frontend\"",
        "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
        "db:migrate": "npm --prefix backend run db:migrate",
        "db:seed": "npm --prefix backend run db:seed",
        "db:setup": "npm --prefix backend run db:setup",
        "test:backend": "npm --prefix backend test",
        "build": "npm --prefix frontend run build",
        "preview": "npm --prefix frontend run preview"
    },
    "devDependencies": {
        "concurrently": "^10.0.6"
    }
}
